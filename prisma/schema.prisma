generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique
  passwordHash String?          @map("password_hash")
  displayName  String?          @map("display_name")
  avatarUrl    String?          @map("avatar_url")
  createdAt    DateTime         @default(now()) @map("created_at")
  books        Book[]
  highlights   Highlight[]
  notes        Note[]
  bookmarks    Bookmark[]
  sessions     ReadingSession[]
  summaries    ChapterSummary[]
  suggestions  BookSuggestion[]

  @@map("profiles")
}

model Book {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  title           String
  author          String?
  description     String?
  coverUrl        String?   @map("cover_url")
  fileUrl         String    @map("file_url")
  fileType        String    @map("file_type")
  status          String    @default("unread") @map("status")
  genres          String[]  @default([]) @map("genres")
  progressPercent Int       @default(0) @map("progress_percent")
  progressCfi     String?   @map("progress_cfi")
  currentPage     Int       @default(0) @map("current_page")
  totalPages      Int?      @map("total_pages")
  lastOpenedAt    DateTime? @map("last_opened_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  profile         Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  highlights      Highlight[]
  notes           Note[]
  bookmarks       Bookmark[]
  sessions        ReadingSession[]
  summaries       ChapterSummary[]

  @@index([userId, lastOpenedAt(sort: Desc)])
  @@map("books")
}

model Highlight {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  text      String
  location  String
  color     String   @default("#FFD700")
  createdAt DateTime @default(now()) @map("created_at")
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@index([userId, bookId])
  @@map("highlights")
}

model Note {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  bookId      String    @map("book_id") @db.Uuid
  highlightId String?   @map("highlight_id") @db.Uuid
  content     String
  createdAt   DateTime  @default(now()) @map("created_at")
  profile     Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  highlight   Highlight? @relation(fields: [highlightId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
  @@map("notes")
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  cfi       String
  label     String?
  createdAt DateTime @default(now()) @map("created_at")
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
  @@map("bookmarks")
}

model ReadingSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  bookId          String    @map("book_id") @db.Uuid
  startedAt       DateTime  @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int       @default(0) @map("duration_seconds")
  wordsRead       Int       @default(0) @map("words_read")
  profile         Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  book            Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
  @@map("reading_sessions")
}

model ChapterSummary {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  bookId       String   @map("book_id") @db.Uuid
  chapterIndex Int      @map("chapter_index")
  content      String
  createdAt    DateTime @default(now()) @map("created_at")
  profile      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, chapterIndex])
  @@map("chapter_summaries")
}

model BookSuggestion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  author      String?
  synopsis    String?
  reason      String?  @map("reason")
  genres      String[] @default([]) @map("genres")
  sourceBooks String[] @map("source_books")
  status      String   @default("suggested") @map("status")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  profile     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, expiresAt])
  @@map("book_suggestions")
}
